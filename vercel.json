{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/cron/reminders?type=daily&slot=12",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/reminders?type=daily&slot=20",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/reminders?type=weekly&slot=sat",
      "schedule": "0 23 * * 5"
    },
    {
      "path": "/api/cron/reminders?type=weekly&slot=sun",
      "schedule": "0 23 * * 6"
    },
    {
      "path": "/api/cron/reminders?type=cycle",
      "schedule": "0 5 * * 6"
    }
  ]
}