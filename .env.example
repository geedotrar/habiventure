# Supabase Public API Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key

# Device Trust Master Secret (Keep strictly server-side)
TRUSTED_DEVICE_SECRET=generate_high_entropy_secret_min_32_chars

# Supabase Private Server Key (Never expose to client bundles)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret

# Supabase CLI Management (Optional, local dev / migrations only)
SUPABASE_ACCESS_TOKEN=

